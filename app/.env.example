# Copier ce fichier en « .env » et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API). La clé « anon » est publique par nature :
# la sécurité repose sur les règles d'accès de la base, pas sur le secret de cette clé.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE-CLE-ANON

# Déconnexion automatique après une période d'inactivité (en minutes). 0 = jamais.
VITE_DECONNEXION_INACTIVITE_MIN=240

# Chemin de l'application : « / » avec un domaine propre, « /nom-du-depot/ » sur GitHub Pages sans domaine.
VITE_BASE=/
